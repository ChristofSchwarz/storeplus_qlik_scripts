
// [Sparte->PrdGrp]:
// MAPPING LOAD
// //     Valid,
//     "Produktgruppe ID",
//     "Produktgruppe Pfad"
// //     "Null-Umsätze filtern"
// FROM [$(vBerechtigungenExcel)]
// (ooxml, embedded labels, header is 1 lines, table is [Schnepf Produktgruppen])
// WHERE
// 	NOT Valid LIKE 'N*';
    
[Sparte->USt]:
MAPPING LOAD
    "Produktgruppe ID"
    ,"Umsatzsteuer in %"
FROM 
    [$(vBerechtigungenExcel)]
    (ooxml, embedded labels, header is 1 lines, table is [Schnepf Produktgruppen])
WHERE
	NOT Valid LIKE 'N*';

[Sparte->Kürzel]:
MAPPING LOAD
    "Produktgruppe ID"
    ,"Produktgruppe Kurz"
FROM 
    [$(vBerechtigungenExcel)]
    (ooxml, embedded labels, header is 1 lines, table is [Schnepf Produktgruppen])
WHERE
	NOT Valid LIKE 'N*';


pdf:
LOAD 
	RecNo() AS Zeile
	,@1
    ,SubField(@1, ' ', 1) AS ArtNr
    ,SubField(@1, ' ', -2) AS Stück
    ,Num#(SubField(@1, ' ', -1), '', '.', ' ') AS Wert
INLINE [

