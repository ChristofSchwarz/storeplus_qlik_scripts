pdf2:
LOAD
	*,
    Left(Artikel2, Len(Artikel2) - Len(Stück) - Len(Wert) - 1) AS Artikel,
   // ApplyMap('Sparte->PrdGrp', Sparte, Sparte) AS ProduktGruppe,
    Repeat('|', Stück - 1) AS Splitter
;
LOAD
	*
//     ,If(@1 LIKE 'Bis * 20?? *', TextBetween(@1, 'Bis ', ':'), Peek('Bis', -1)) AS Bis
    ,If(@1 LIKE 'Bis * 20?? *', Peek('@1', -1), Peek('Von', -1)) AS Von
    ,If(@1 LIKE 'Sparte: *', SubField(@1, 'Sparte: ', 2), Peek('Sparte', -1)) AS Sparte
    ,Mid(@1, Len(ArtNr)+1) AS Artikel2
RESIDENT
	pdf;
    
DROP TABLE pdf;

pdf3:
  NOCONCATENATE LOAD
  *
  ,Date(
      MakeDate(SubField(Von, ' ', 3), WildMatch(SubField(Von, ' ', 2), 'Jan*', 'Feb*', 'Mär*', 'Apr*', 'Mai', 'Jun*', 'Jul*', 'Aug*', 'Sep*', 'Okt*', 'Nov*', 'Dez*'), SubField(Von, ' ', 1)) 
      ,'YYYY-MM-DD') AS Von2
  // ,Left(Bis, Len(Bis) -3) AS Bis2
RESIDENT pdf2
WHERE NOT Wildmatch([@1], 'Sparte: *', 'Bis *', '* * 20??');

DROP TABLE pdf2;
DROP FIELD Von;
// DROP FIELD Bis;
// RENAME FIELD Bis2 TO Bis;
RENAME FIELD Von2 TO Von;

// Füge die aus PDF stammenden Daten zu der Melzer Kassentabelle hinzu

CONCATENATE ([schnepf_invoice+item])
LOAD
	'True'                                                      AS invoice.valid
    ,'PDF Monatsjournal'                                        AS invoice.invoice_type
    ,'PDF Monatsjournal'                                        AS invoice.customer_name // neu 7-Okt-2024
    ,'2'                                                        AS invoice.site_number // Shell Gleisdorf
	,*
    ,item.gross_price 
    	- 100 * item.gross_price / (100 + item.tax_precentage)  AS item.tax_amount   
	,100 * item.gross_price / (100 + item.tax_precentage)       AS item.net_price  
;
LOAD
    Lower(Left(KeepChar(Repeat(Hash256(Von, Zeile), 10)   
            ,'0123456789ABCDEFGHIJKLMOPQRSTUVWXYZ'), 36))       AS invoice.uid
    ,Date(Floor(MonthEnd(Von)))                                 AS invoice.modification_date
    ,Date(Floor(MonthEnd(Von)))                                 AS invoice.posted_date    
    ,'PDF' & ArtNr                                              AS item.product_number       
	,Artikel                                                    AS item.product_description            
	,Replace(
        Sparte & ' [' & ApplyMap('Sparte->Kürzel', Sparte, Null())
        & ']', ' []', '')                                       AS item.melzer_product_group             
	,Stück                                                      AS item.amount	
    ,Wert                                                       AS item.gross_price    
	,Coalesce(ApplyMap('Sparte->USt', Sparte, Null()), 20)      AS item.tax_precentage       
	,Wert / Stück                                               AS item.unit_price 
    ,1                                                          AS item.itemid  // immer nur 1 item pro "beleg"

RESIDENT                                                    
	pdf3;
    
    

