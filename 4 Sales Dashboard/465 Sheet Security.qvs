/*

Hier importieren wir alle User und die Sheets, die ihnen zugeordnet werden, aus
verschiedenen Tabellen. 
 - Gebietsleiter aus TankstellenHierarchie
 - QMC Users with SalesDashboardSheets custom property
 - Qlik Sense Administrators laut AD Gruppe
 - Qlik Sense RootAdmins laut QMC
 
 Weiter unten definieren wir vereinfachte Hide-Formeln für die Sheets selbst 
*/


Sheets:
LOAD
    QMC.QLIK_USER                                 AS Sheet.USERID
    ,QMC.OSUSER                                   AS Sheet.OSUSER
    ,QMC.UserName                                 AS Sheet.UserName
    ,QMC.QLIK_USER & QMC.SalesDashboardSheets     AS [~QMCSHEETSUSER]
    ,QMC.SalesDashboardSheets                     AS Sheet.Scope
    ,'Custom Property SalesDashboardSheets (QMC)' AS Sheet.Reason    
RESIDENT
	tQMCusers
WHERE
	Len(QMC.SalesDashboardSheets)
;


CONCATENATE (Sheets)
LOAD DISTINCT
    [Tankstelle/Arbeitsblätter]               AS Sheet.Scope
    ,'STIGLECHNER\' & Trim(Upper(UserID))     AS Sheet.USERID
    ,Applymap('Lookup_OSUser_By_UserId', 'STIGLECHNER\' & Trim(Upper(UserID)), Null())
                                              AS Sheet.OSUSER
    ,ApplyMap('Lookup_UserName_By_UserId', 'STIGLECHNER\' & Trim(Upper(UserID)), UserID)
                                              AS Sheet.UserName
    ,'Excel Matrix'                           AS Sheet.Reason
RESIDENT
	[~UserTankstellen+SheetsMapping]
WHERE
	MixMatch(HasAccess, '1', 'X', 'Y', '*', 'j')
    AND NOT Exists([~QMCSHEETSUSER], 'STIGLECHNER\' & Trim(Upper(UserID)) & [Tankstelle/Arbeitsblätter])
    AND [Berechtigungs Kategorie] LIKE 'Arbeitsblätter';
    
DROP FIELD [~QMCSHEETSUSER] FROM Sheets;


