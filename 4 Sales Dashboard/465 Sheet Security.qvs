/*
Zugriff auf Sheets mit unten folgenden "Hide-Formulas" in den Sheets geregelt.

Die Verwendung ist so
$(vSheetAccess(1)) ... bei den Hide Formeln im Sheet
$(vSheetAccess($)) ... in einer Tabelle auf dem Sheet "Security", wo man für alle
                       Benutzer eine Übersicht erhält, ob die betreffende Formel zutrifft.

Also, der Parameter $ steuert in den Formeln etwas anders, da hier nicht der OSUser() sondern
das Feld UserName verglichen wird, das es in der Tabelle tUsers gibt.

*/

LET vSheetSecurityShowAll = 1;  // variable für einen Toggle im Sheet "Security", kann 1 oder $ sein
SET vOSUserOrUserName = IF($1=1, Sheet.OSUSER LIKE OSUser(), NOT IsNull(Sheet.OSUSER));


SET vSheetAccess1 = RangeMin(1, -Sum({$1 <Sheet.Scope={"Alle"}>} $(vOSUserOrUserName)));
SET vSheetAccess = RangeMin(1, -Sum({$1 <Sheet.Scope={"Alle"}+{'$2'}>} $(vOSUserOrUserName)));

SET vSheetAccessQV = RangeMin(1, -Sum({$1 <Sheet.Scope={"(Alle|QlikView)"}>} $(vOSUserOrUserName)));

// Developer Sheets
SET vSheetAccessDev = RangeMin(1, -Sum({$1 <Sheet.Scope={"Dev"}>} $(vOSUserOrUserName)));

// Stations MA Sheets
SET vSheetAccessStation = RangeMin(1, -Sum({$1 <Sheet.Scope={"(Alle|Tankstellen|Gebietsleiter)"}>} $(vOSUserOrUserName)));

// Regionsleiter Sheets
SET vSheetAccessRegion = RangeMin(1, -Sum({$1 <Sheet.Scope={"(Alle|Gebietsleiter)"}>} $(vOSUserOrUserName)));

LET vOSUserOrUserName = Null();


